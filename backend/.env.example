# ==============================================================================
# GSFC UNIVERSITY PLACEMENT & AI CAREER SUITE - PRODUCTION CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. LOCAL OMNIROUTE / OPENAI-COMPATIBLE AI GATEWAY
# ------------------------------------------------------------------------------
AI_GATEWAY_URL=http://localhost:20128/v1
AI_API_KEY=sk-your-omniroute-api-key
AI_MODEL=auto

# ------------------------------------------------------------------------------
# 2. PRIMARY CLOUD AI ENGINE (Google Gemini API Key)
# Obtain from: https://aistudio.google.com / Google Cloud Console
# Cost: Free Tier available / ~$0.0001 per request (~₹300 - ₹500/month)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYOUR_OFFICIAL_GSFC_GEMINI_KEY_HERE

# ------------------------------------------------------------------------------
# 3. SECONDARY / FALLBACK AI ENGINE (Optional Dual-Check Provider)
# Options: 'gemini' | 'claude' | 'llama' | 'dual_check'
# ------------------------------------------------------------------------------
AI_GRADING_PROVIDER=dual_check
CLAUDE_API_KEY=sk-ant-api03-YOUR_CLAUDE_KEY_HERE

# ------------------------------------------------------------------------------
# 5. GOOGLE IDENTITY SERVICES & AUTHENTICATION (Sign in with Google)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth2-client-secret
ALLOWED_GOOGLE_DOMAINS=gsfcuniversity.ac.in

# ------------------------------------------------------------------------------
# 6. SESSION & APPLICATION SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=your-secure-production-jwt-secret-minimum-32-chars
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001


