# ==============================================================================
# GSFC UNIVERSITY PLACEMENT & AI CAREER SUITE - PRODUCTION CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. PRIMARY AI ENGINE (Google Gemini API Key)
# Obtain from: https://aistudio.google.com / Google Cloud Console
# Cost: Free Tier available / ~$0.0001 per request (~₹300 - ₹500/month)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYOUR_OFFICIAL_GSFC_GEMINI_KEY_HERE

# ------------------------------------------------------------------------------
# 2. SECONDARY / FALLBACK AI ENGINE (Optional Dual-Check Provider)
# Options: 'gemini' | 'claude' | 'llama' | 'dual_check'
# ------------------------------------------------------------------------------
AI_GRADING_PROVIDER=dual_check
CLAUDE_API_KEY=sk-ant-api03-YOUR_CLAUDE_KEY_HERE

# ------------------------------------------------------------------------------
# 3. UNIVERSITY SMTP EMAIL GATEWAY (For Mailing ATS Reports & Notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tpc@gsfcuniversity.ac.in
SMTP_PASS=YOUR_APP_SPECIFIC_PASSWORD
