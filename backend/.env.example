# ==============================================================================
# GSFC UNIVERSITY PLACEMENT & AI CAREER SUITE - PRODUCTION CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.vercel.app
BACKEND_URL=https://your-backend-domain.onrender.com

# Primary Database (Supabase PostgreSQL Connection Pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. SESSION & CRYPTOGRAPHIC SECURITY (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# High-entropy random secret (32+ characters). Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-production-jwt-secret-minimum-32-chars

# ------------------------------------------------------------------------------
# 3. INITIAL PRODUCTION ADMINISTRATOR BOOTSTRAP (MANDATORY ON FIRST BOOT)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@gsfcuniversity.ac.in
INITIAL_ADMIN_PASSWORD=YourStrongAdminPassword2026!

# ------------------------------------------------------------------------------
# 4. CLOUD AI ENGINE (Google Gemini API Key)
# Obtain from: https://aistudio.google.com
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourOfficialGSFCGeminiKeyHere

# OmniRoute Local AI Gateway (Optional)
AI_GATEWAY_URL=http://localhost:20128/v1
AI_API_KEY=sk-your-omniroute-api-key
AI_MODEL=auto

# ------------------------------------------------------------------------------
# 5. GOOGLE IDENTITY SERVICES & AUTHENTICATION (Sign in with Google)
# Obtain from: Google Cloud Console > APIs & Services > Credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth2-client-secret
ALLOWED_GOOGLE_DOMAINS=gsfcuniversity.ac.in

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & PASSWORD RESET NOTIFIER (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tpc@gsfcuniversity.ac.in
SMTP_PASS=your-app-specific-password
SMTP_FROM="GSFC University TPC" <tpc@gsfcuniversity.ac.in>
