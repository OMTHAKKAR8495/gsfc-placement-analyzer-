{
  "name": "campushire-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node backend/index.js",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "build:all": "npm --prefix frontend install && npm --prefix frontend run build && npm --prefix backend install",
    "test": "npm --prefix backend test",
    "mobile:build": "npm --prefix frontend run mobile:build",
    "mobile:android": "npm --prefix frontend run mobile:android",
    "mobile:ios": "npm --prefix frontend run mobile:ios"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.3"
  }
}
