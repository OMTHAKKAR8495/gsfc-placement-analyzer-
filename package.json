{
  "name": "campushire-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "mobile:build": "npm --prefix frontend run mobile:build",
    "mobile:android": "npm --prefix frontend run mobile:android",
    "mobile:ios": "npm --prefix frontend run mobile:ios"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
